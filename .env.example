# Copy to .env.local and fill in values. Never commit .env.local.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public URL where Catch of the Day is deployed (thumbnail opens this in a new tab).
# MUST be HTTPS and non-empty — if blank, Catch of the Day opens the large image popup only.
# Example: https://catch-of-the-day-menu.vercel.app/store/sirnetz
VITE_CATCH_OF_THE_DAY_URL=
